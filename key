-- ==================== UTILITY FUNCTIONS ====================
local function TableFind(tbl, value)
    for i, v in ipairs(tbl) do
        if v == value then return i end
    end
    return nil
end

local function StringTrim(str)
    return (str:gsub("^%s*(.-)%s*$", "%1"))
end

local function Tween(obj, info, props)
    if not obj or not obj.Parent then return end
    local t = TweenService:Create(obj, info, props)
    t:Play()
    return t
end

-- ==================== KEY FILE MANAGEMENT ====================
local function SaveKey(key)
    local timestamp = os.time()
    pcall(function() writefile(FilePath, key .. "|" .. timestamp) end)
end

local function LoadKeyFromFile()
    local success, data = pcall(function() return readfile(FilePath) end)
    if not success then return nil end
    
    local parts = {}
    for part in data:gmatch("[^|]+") do table.insert(parts, part) end
    
    if #parts == 2 then
        local key = parts[1]
        local timestamp = tonumber(parts[2])
        local now = os.time()
        local hours = (now - timestamp) / 3600
        
        if hours < KeyExpireHours then
            return key
        else
            pcall(function() delfile(FilePath) end)
            return nil
        end
    end
    return nil
end

local function GetKeyListFromServer()
    local success, response = pcall(function()
        return game:HttpGet(KeyServerUrl)
    end)
    
    if not success then return nil end
    
    local keys = {}
    for line in response:gmatch("[^\n]+") do
        local trimmed = StringTrim(line)
        if trimmed ~= "" then table.insert(keys, trimmed) end
    end
    
    return #keys > 0 and keys or nil
end

local function IsKeyValid(key)
    local serverKeys = GetKeyListFromServer()
    if not serverKeys then return false end
    return TableFind(serverKeys, key) ~= nil
end

