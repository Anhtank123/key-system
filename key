-- ==================== NOTIFICATION SYSTEM ====================
local Fluent = nil
local function TryLoadFluent()
    local success = pcall(function()
        Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()
    end)
    return success and Fluent or nil
end

local function NotifySuccess(title, message)
    if Fluent then
        Fluent:Notify({Title = title, Content = message, Duration = 3, Icon = "check"})
    else
        print("✅ " .. title .. ": " .. message)
    end
end

local function NotifyError(title, message)
    if Fluent then
        Fluent:Notify({Title = title, Content = message, Duration = 3, Icon = "x"})
    else
        print("❌ " .. title .. ": " .. message)
    end
end

-- ==================== SHAKE ANIMATION ====================
local function ShakeUI(frame)
    for i = 1, 6 do
        frame.Position = UDim2.new(0.5, (i % 2 == 0 and -5 or 5), frame.Position.Y.Scale, frame.Position.Y.Offset)
        task.wait(0.05)
    end
    frame.Position = UDim2.new(0.5, 0, frame.Position.Y.Scale, frame.Position.Y.Offset)
end

